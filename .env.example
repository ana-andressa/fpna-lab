# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/seu_banco

# OU se for SQL Server:
# DATABASE_URL=mssql+pyodbc://usuario:senha@seu_servidor/seu_banco?driver=ODBC+Driver+17+for+SQL+Server

# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite .env com suas credenciais reais
# 3. NUNCA faça commit de .env (já está em .gitignore)
